@page "/property/update/{PropertyId:int}"
@using PaymentTrackingSystem.Web.Client.Pages.Layout
@using PaymentTrackingSystem.Client.Infrastructure.Interface
@using PaymentTrackingSystem.Shared
@using Radzen
@using Radzen.Blazor

@layout PTSMainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="property-page">
    <div class="container py-4 py-lg-5">
        @if (property == null)
        {
            <div class="loading-card">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 mb-0 text-muted">Loading property details...</p>
            </div>
        }
        else
        {
            <div class="page-heading mb-4">
                <div>
                    <div class="eyebrow">PROPERTY MANAGEMENT</div>
                    <h1>Update property</h1>
                    <p class="text-muted mb-0">
                        Review and update the property information below.
                    </p>
                </div>

                <div class="property-reference">
                    <span class="reference-label">Property ID</span>
                    <strong>#@property.PropertyId</strong>
                </div>
            </div>

            <EditForm Model="@property" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                @if (errorMessages != null && errorMessages.Any(m => !string.IsNullOrWhiteSpace(m)))
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
                        <div class="d-flex gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <strong>Unable to update property</strong>
                                <ul class="mb-0 mt-2">
                                    @foreach (var message in errorMessages.Where(m => !string.IsNullOrWhiteSpace(m)))
                                    {
                                        <li>@message</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="form-card">
                            <div class="form-card-header">
                                <div class="section-icon">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div>
                                    <h2>Property details</h2>
                                    <p>Enter the basic information for this property.</p>
                                </div>
                            </div>

                            <div class="form-card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="propertyName" class="form-label">
                                            Property name <span class="required">*</span>
                                        </label>
                                        <InputText id="propertyName"
                                                   @bind-Value="property.PropertyName"
                                                   class="form-control"
                                                   placeholder="Enter property name" />
                                        <ValidationMessage For="@(() => property.PropertyName)" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="propertyTypeId" class="form-label">
                                            Property type <span class="required">*</span>
                                        </label>
                                        <InputSelect id="propertyTypeId"
                                                     @bind-Value="property.PropertyTypeId"
                                                     @bind-Value:after="OnPropertyTypeChanged"
                                                     class="form-select">
                                            <option value="">Select property type</option>
                                            @foreach (var propertyType in propertyTypesData)
                                            {
                                                <option value="@propertyType.PropertyTypeId">
                                                    @propertyType.PropertyTypeName
                                                </option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => property.PropertyTypeId)" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-card mt-4">
                            <div class="form-card-header">
                                <div class="section-icon green">
                                    <i class="bi bi-person"></i>
                                </div>
                                <div>
                                    <h2>Owner information</h2>
                                    <p>Keep the owner contact details up to date.</p>
                                </div>
                            </div>

                            <div class="form-card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="ownerName" class="form-label">
                                            Owner name <span class="required">*</span>
                                        </label>
                                        <InputText id="ownerName"
                                                   @bind-Value="property.PropertOwnerName"
                                                   class="form-control"
                                                   placeholder="Enter owner name" />
                                        <ValidationMessage For="@(() => property.PropertOwnerName)" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="mobileNumber" class="form-label">
                                            Mobile number <span class="required">*</span>
                                        </label>
                                        <InputText id="mobileNumber"
                                                   @bind-Value="property.OwnerMobileNumber"
                                                   class="form-control"
                                                   placeholder="Enter mobile number" />
                                        <ValidationMessage For="@(() => property.OwnerMobileNumber)" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-card mt-4">
                            <div class="form-card-header">
                                <div class="section-icon orange">
                                    <i class="bi bi-geo-alt"></i>
                                </div>
                                <div>
                                    <h2>Property address</h2>
                                    <p>Provide the complete location of the property.</p>
                                </div>
                            </div>

                            <div class="form-card-body">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label for="addressLine1" class="form-label">
                                            Address line 1 <span class="required">*</span>
                                        </label>
                                        <InputText id="addressLine1"
                                                   @bind-Value="property.AddressLine1"
                                                   class="form-control"
                                                   placeholder="House number and street name" />
                                        <ValidationMessage For="@(() => property.AddressLine1)" />
                                    </div>

                                    <div class="col-12">
                                        <label for="addressLine2" class="form-label">
                                            Address line 2
                                        </label>
                                        <InputText id="addressLine2"
                                                   @bind-Value="property.AddressLine2"
                                                   class="form-control"
                                                   placeholder="Apartment, suite, area, or landmark" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="postcode" class="form-label">
                                            Postcode <span class="required">*</span>
                                        </label>
                                        <InputText id="postcode"
                                                   @bind-Value="property.Postcode"
                                                   class="form-control"
                                                   placeholder="Enter postcode" />
                                        <ValidationMessage For="@(() => property.Postcode)" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="countryId" class="form-label">
                                            Country <span class="required">*</span>
                                        </label>
                                        <InputSelect id="countryId"
                                                     @bind-Value="property.CountryId"
                                                     @bind-Value:after="OnCountryChanged"
                                                     class="form-select">
                                            <option value="">Select country</option>
                                            @foreach (var country in countriesData)
                                            {
                                                <option value="@country.CountryId">
                                                    @country.CountryName
                                                </option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => property.CountryId)" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check2-circle me-2"></i>
                                Save changes
                            </button>
                            <a href="/property/list" class="btn btn-warning px-4">
                                Cancel
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="summary-card">
                            <div class="summary-card-header">
                                <span class="summary-icon">
                                    <i class="bi bi-pencil-square"></i>
                                </span>
                                <div>
                                    <h3>Update summary</h3>
                                    <p>Property record</p>
                                </div>
                            </div>

                            <div class="summary-row">
                                <span>Property ID</span>
                                <strong>#@property.PropertyId</strong>
                            </div>

                            <div class="summary-row">
                                <span>Name</span>
                                <strong>@(string.IsNullOrWhiteSpace(property.PropertyName) ? "Not provided" : property.PropertyName)</strong>
                            </div>

                            <div class="summary-row">
                                <span>Owner</span>
                                <strong>@(string.IsNullOrWhiteSpace(property.PropertOwnerName) ? "Not provided" : property.PropertOwnerName)</strong>
                            </div>

                            <div class="summary-note">
                                <i class="bi bi-info-circle me-2"></i>
                                Fields marked with <span class="required">*</span> are required.
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

<style>
    .property-page {
        min-height: calc(100vh - 80px);
        background: #f5f7fb;
    }

    .page-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .eyebrow {
        color: #2563eb;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .12em;
        margin-bottom: .45rem;
    }

    .page-heading h1 {
        color: #172033;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: .35rem;
    }

    .property-reference {
        min-width: 130px;
        padding: .85rem 1rem;
        border: 1px solid #e5eaf2;
        border-radius: .75rem;
        background: #fff;
        text-align: center;
        box-shadow: 0 4px 16px rgba(30, 55, 90, .05);
    }

    .reference-label {
        display: block;
        color: #8792a5;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .property-reference strong {
        color: #2563eb;
        font-size: 1.15rem;
    }

    .form-card,
    .summary-card,
    .loading-card {
        border: 1px solid #e5eaf2;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 8px 28px rgba(30, 55, 90, .06);
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #edf0f5;
    }

    .form-card-header h2,
    .summary-card h3 {
        color: #172033;
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
    }

    .form-card-header p,
    .summary-card-header p {
        color: #8a95a8;
        font-size: .82rem;
        margin: .2rem 0 0;
    }

    .form-card-body {
        padding: 1.5rem;
    }

    .section-icon,
    .summary-icon {
        display: grid;
        width: 2.45rem;
        height: 2.45rem;
        place-items: center;
        border-radius: .7rem;
        color: #2563eb;
        background: #eaf2ff;
        font-size: 1.15rem;
    }

    .section-icon.green {
        color: #14966a;
        background: #e8f8f1;
    }

    .section-icon.orange {
        color: #d97706;
        background: #fff4df;
    }

    .form-label {
        color: #344054;
        font-size: .84rem;
        font-weight: 600;
        margin-bottom: .45rem;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-color: #dfe5ee;
        border-radius: .55rem;
        color: #293548;
        font-size: .9rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #5790ed;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .1);
    }

    .required {
        color: #dc3545;
    }

    .validation-message {
        display: block;
        margin-top: .35rem;
        color: #dc3545;
        font-size: .78rem;
    }

    .summary-card {
        position: sticky;
        top: 1.5rem;
        overflow: hidden;
    }

    .summary-card-header {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #2563eb, #1746a2);
    }

    .summary-card-header h3,
    .summary-card-header p {
        color: #fff;
    }

    .summary-card-header p {
        opacity: .75;
    }

    .summary-icon {
        color: #fff;
        background: rgba(255, 255, 255, .16);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #edf0f5;
        font-size: .84rem;
    }

    .summary-row span {
        color: #8792a5;
    }

    .summary-row strong {
        max-width: 58%;
        overflow: hidden;
        color: #293548;
        text-align: right;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .summary-note {
        padding: 1rem 1.5rem;
        color: #68758a;
        background: #f8fafc;
        font-size: .78rem;
    }

    .form-actions {
        display: flex;
        gap: .75rem;
    }

    .btn {
        min-height: 44px;
        border-radius: .55rem;
        font-size: .88rem;
        font-weight: 600;
    }

    .btn-primary {
        background: #2563eb;
        border-color: #2563eb;
    }

    .btn-primary:hover {
        background: #1746a2;
        border-color: #1746a2;
    }

    .loading-card {
        display: flex;
        min-height: 240px;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

    @@media (max-width: 767.98px) {
        .page-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .property-reference {
            width: 100%;
        }

        .form-card-header,
        .form-card-body {
            padding: 1.1rem;
        }

        .summary-card {
            position: static;
        }
    }
</style>
