@page "/tenant/add"
@using PaymentTrackingSystem.Web.Client.Pages.Layout
@using Microsoft.AspNetCore.Components.Forms

@layout PTSMainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Add Tenant</PageTitle>

<div class="tenant-add-page">
    <div class="page-background"></div>

    <div class="container page-container">
        <div class="page-heading">
            <div>
                <div class="breadcrumb">
                    <span>Tenants</span>
                    <span class="breadcrumb-separator">/</span>
                    <strong>Add Tenant</strong>
                </div>

                <h1>Create a new tenant</h1>
                <p class="page-subtitle">
                    Add the tenant's organization and contact information to get started.
                </p>
            </div>

            <div class="heading-icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 21h18" />
                    <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16" />
                    <path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1" />
                </svg>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <div class="header-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <line x1="19" y1="8" x2="19" y2="14" />
                        <line x1="22" y1="11" x2="16" y2="11" />
                    </svg>
                </div>

                <div>
                    <h2>Tenant information</h2>
                    <p>Complete the details below. Fields marked with an asterisk are required.</p>
                </div>
            </div>

            @if (errorMessages.Count > 0)
            {
                <div class="validation-summary" role="alert">
                    <div class="validation-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                    </div>

                    <div>
                        <strong>Please correct the following:</strong>
                        <ul>
                            @foreach (var message in errorMessages)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <EditForm Model="@tenant" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="form-content">
                    <TenantForm Model="tenant" Countries="countries" States="states" />
                </div>

                <div class="form-footer">
                    <div class="required-note">
                        <span class="required-mark">*</span>
                        Required fields
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-cancel" @onclick="Cancel">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-submit">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                                <polyline points="17 21 17 13 7 13 7 21" />
                                <polyline points="7 3 7 8 15 8" />
                            </svg>
                            Create tenant
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .tenant-add-page {
        position: relative;
        min-height: calc(100vh - 64px);
        padding: 42px 0 64px;
        background: #f5f7fb;
        overflow: hidden;
    }

    .page-background {
        position: absolute;
        inset: 0 0 auto;
        height: 280px;
        background: linear-gradient(135deg, #173b75 0%, #2463b7 58%, #438ed0 100%);
        clip-path: ellipse(82% 78% at 50% 0%);
    }

    .page-background::after {
        position: absolute;
        top: -100px;
        right: -70px;
        width: 360px;
        height: 360px;
        border: 1px solid rgba(255, 255, 255, .13);
        border-radius: 50%;
        box-shadow: 0 0 0 24px rgba(255, 255, 255, .035),
                    0 0 0 48px rgba(255, 255, 255, .025);
        content: "";
    }

    .page-container {
        position: relative;
        z-index: 1;
        max-width: 1080px;
    }

    .page-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 30px;
        color: #fff;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 13px;
        color: rgba(255, 255, 255, .72);
        font-size: .86rem;
    }

    .breadcrumb strong {
        color: #fff;
        font-weight: 600;
    }

    .breadcrumb-separator {
        color: rgba(255, 255, 255, .45);
    }

    .page-heading h1 {
        margin: 0;
        font-size: clamp(1.8rem, 3vw, 2.35rem);
        font-weight: 700;
        letter-spacing: -.03em;
    }

    .page-subtitle {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, .78);
        font-size: .98rem;
    }

    .heading-icon {
        display: grid;
        flex: 0 0 64px;
        width: 64px;
        height: 64px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, .25);
        border-radius: 18px;
        background: rgba(255, 255, 255, .14);
        color: #fff;
        backdrop-filter: blur(8px);
    }

    .form-card {
        overflow: hidden;
        border: 1px solid #e4e9f2;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 18px 45px rgba(22, 48, 86, .12);
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 25px 32px;
        border-bottom: 1px solid #edf0f5;
        background: linear-gradient(180deg, #fff 0%, #fbfcfe 100%);
    }

    .header-icon {
        display: grid;
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        place-items: center;
        border-radius: 12px;
        background: #eaf2ff;
        color: #2463b7;
    }

    .form-card-header h2 {
        margin: 0;
        color: #172b4d;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .form-card-header p {
        margin: 4px 0 0;
        color: #718096;
        font-size: .88rem;
    }

    .validation-summary {
        display: flex;
        gap: 12px;
        margin: 24px 32px 0;
        padding: 14px 16px;
        border: 1px solid #f3b9b9;
        border-radius: 10px;
        background: #fff5f5;
        color: #9b2c2c;
        font-size: .9rem;
    }

    .validation-summary strong {
        display: block;
        margin-bottom: 4px;
    }

    .validation-summary ul {
        margin: 0;
        padding-left: 18px;
    }

    .validation-icon {
        flex: 0 0 auto;
        color: #d64545;
    }

    .form-content {
        padding: 30px 32px 34px;
    }

    .form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 32px;
        border-top: 1px solid #edf0f5;
        background: #fafbfd;
    }

    .required-note {
        color: #8491a5;
        font-size: .82rem;
    }

    .required-mark {
        color: #d64545;
        font-weight: 700;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 8px;
        font-size: .92rem;
        font-weight: 600;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn-cancel {
        border: 1px solid #d8e0eb;
        background: #fff;
        color: #536174;
    }

    .btn-cancel:hover {
        border-color: #b8c5d6;
        background: #f6f8fb;
    }

    .btn-submit {
        border: 0;
        background: #2463b7;
        color: #fff;
        box-shadow: 0 5px 12px rgba(36, 99, 183, .22);
    }

    .btn-submit:hover {
        background: #1d559f;
        box-shadow: 0 7px 16px rgba(36, 99, 183, .3);
    }

    @@media (max-width: 576px) {
        .tenant-add-page {
            padding-top: 28px;
        }

        .page-heading {
            align-items: flex-start;
        }

        .heading-icon {
            display: none;
        }

        .form-card-header,
        .form-content {
            padding-right: 20px;
            padding-left: 20px;
        }

        .form-footer {
            align-items: stretch;
            flex-direction: column;
            padding: 18px 20px;
        }

        .form-actions {
            width: 100%;
        }

        .form-actions .btn {
            flex: 1;
        }

        .validation-summary {
            margin-right: 20px;
            margin-left: 20px;
        }
    }
</style>